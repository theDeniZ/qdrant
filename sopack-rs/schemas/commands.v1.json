{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sopack.sdarm.org/schemas/commands.v1.json",
  "title": "sopack commands --json output (v1)",
  "description": "Describes every subcommand, flag, result schema and exit code this installed binary supports — generated from clap's command tree so it cannot drift (SOPACK-1.0-PLAN.md §3.5). Produced by crates/sopack-cli/src/commands/commands_cmd.rs.",
  "type": "object",
  "required": ["version", "global_args", "exit_codes", "commands"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "global_args": { "type": "array", "items": { "$ref": "#/$defs/arg" } },
    "exit_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "description"],
        "properties": {
          "code": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "about", "args", "result_schema"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "about": { "type": ["string", "null"] },
          "args": { "type": "array", "items": { "$ref": "#/$defs/arg" } },
          "result_schema": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "arg": {
      "type": "object",
      "required": ["name", "positional", "required", "multiple", "default", "help"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "positional": { "type": "boolean" },
        "required": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "default": { "type": ["string", "null"] },
        "help": { "type": ["string", "null"] }
      }
    }
  }
}
