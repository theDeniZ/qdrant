{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sopack.sdarm.org/schemas/inspect.v1.json",
  "title": "sopack inspect output (v1)",
  "description": "The JSON `sopack inspect <book.json> --json` prints to stdout. Produced by crates/sopack-book/src/inspect.rs (`InspectReport`).",
  "type": "object",
  "required": ["file", "profile", "id_rule", "blocks", "stats", "paragraphs", "collided_para_keys", "split_blocks", "book_code", "lang", "title"],
  "additionalProperties": false,
  "properties": {
    "file": { "type": "string" },
    "profile": { "type": "string" },
    "id_rule": { "type": "string" },
    "blocks": { "type": "integer", "minimum": 0 },
    "stats": { "type": "object" },
    "paragraphs": { "type": "integer", "minimum": 0 },
    "collided_para_keys": { "type": "integer", "minimum": 0 },
    "split_blocks": { "type": "integer", "minimum": 0 },
    "book_code": {},
    "lang": {},
    "title": {},
    "bible": {
      "description": "Present for profile \"bible\" only: coverage of the OSIS verse keys.",
      "type": "object",
      "required": ["books", "chapters", "verses", "missing_books", "split_verses", "invalid_keys"],
      "additionalProperties": false,
      "properties": {
        "books": { "type": "integer", "minimum": 0 },
        "chapters": { "type": "integer", "minimum": 0 },
        "verses": { "type": "integer", "minimum": 0 },
        "missing_books": { "type": "array", "items": { "type": "string" } },
        "split_verses": { "type": "integer", "minimum": 0 },
        "invalid_keys": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
