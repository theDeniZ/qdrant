{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdarm.local/sopack/book.schema.json",
  "title": "sopack.book/1",
  "description": "The reviewable intermediate written by `sopack extract` and read by `sopack pack`. See docs/IMPORT-PIPELINE-PLAN.md §3. Structural shape only — semantic rules (required metadata per corpus, id_rule vs. profile, chunk/seq consistency) live in sopack.book.validate(), not here.",
  "type": "object",
  "required": ["schema", "profile", "source", "book", "id_rule", "stats", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sopack.book/1"
    },
    "profile": {
      "type": "string",
      "enum": ["sop", "bible"]
    },
    "source": {
      "type": "object",
      "required": ["file", "sha256", "kind"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "sha256": {"type": ["string", "null"]},
        "kind": {"type": "string", "enum": ["epub", "markdown", "text", "sop_json"]},
        "acquired_from": {"type": ["string", "null"]},
        "rights": {"type": ["string", "null"]}
      }
    },
    "book": {
      "type": "object",
      "description": "Left null wherever the extractor could not read it. sopack.book.validate() decides what is actually required (author/year only for non-EGW works, i.e. when corpus is set).",
      "additionalProperties": false,
      "properties": {
        "book_code": {"type": ["string", "null"]},
        "lang": {"type": ["string", "null"]},
        "book_pair": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "author": {"type": ["string", "null"]},
        "year": {"type": ["integer", "null"]},
        "slug": {"type": ["string", "null"]},
        "corpus": {"type": ["string", "null"]},
        "page_kind": {"type": ["string", "null"], "enum": ["print", "chapter", null]},
        "description": {"type": ["string", "null"]}
      }
    },
    "id_rule": {
      "type": "string",
      "description": "Fixed at first import. Must be one of contract.ID_RULES and valid for `profile` (see contract.PROFILES[profile].id_rules). Re-extracting a book with a changed id_rule is refused elsewhere in the pipeline — it would orphan every point already written."
    },
    "alignment": {
      "type": ["object", "null"],
      "description": "de/en only. Carries the sop_json source's en_reverse map verbatim.",
      "additionalProperties": false,
      "properties": {
        "en_code": {"type": ["string", "null"]},
        "en_reverse": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["blocks_in", "blocks_out", "dropped", "damage", "words", "dropped_detail"],
      "additionalProperties": false,
      "properties": {
        "blocks_in": {"type": "integer", "minimum": 0},
        "blocks_out": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "damage": {"type": "number", "minimum": 0},
        "words": {"type": "integer", "minimum": 0},
        "dropped_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["para_key", "reason"],
            "properties": {
              "para_key": {"type": "string"},
              "reason": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["para_key", "page", "para", "seq", "chunks", "text", "words"],
        "additionalProperties": false,
        "properties": {
          "para_key": {"type": "string"},
          "page": {"type": "integer"},
          "para": {"type": "integer"},
          "seq": {"type": "integer", "minimum": 0},
          "chunks": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "words": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
